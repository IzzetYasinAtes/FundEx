{
  "ConnectionStrings": {
    "FundExDb": "Server=localhost;Database=FundExDb;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "TefasApi": {
    "BaseUrl": "https://tefas.takasbank.com.tr/api/funds/",
    "RequestDelayMs": 300,
    "PageSize": 500,
    "BackfillYears": 10
  },
  "JwtSettings": {
    "SecretKey": "FundExSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "FundEx",
    "Audience": "FundExClients",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
